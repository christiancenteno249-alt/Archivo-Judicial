# ============================================================
# .htaccess — Sistema Archivo Judicial
# Arquitectura: MVC + Fallback Legacy (Patrón Estrangulador)
# ============================================================
RewriteEngine On
RewriteBase /


# ─── 2. SERVIR ARCHIVOS FISICOS REALES (assets, imágenes, etc.) ──────────────
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule .* - [L]

# ─── 3. TODAS LAS URLS LIMPIAS → FRONT CONTROLLER MVC ────────────────────────
# El index.php (Front Controller) recibe la petición, la despacha al
# controlador MVC correspondiente y, si no existe, hace fallback al .php legacy.
RewriteRule ^(.*)$ index.php [L,QSA]

# ─── SEGURIDAD ────────────────────────────────────────────────────────────────
<FilesMatch "\.(md|sql|log)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<Files "conexion.php">
    Order allow,deny
    Deny from all
</Files>

<Files "auth_check.php">
    Order allow,deny
    Deny from all
</Files>

<Files "auditoria_functions.php">
    Order allow,deny
    Deny from all
</Files>

Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>
